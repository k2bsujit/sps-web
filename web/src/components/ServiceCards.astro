---
import Img from './Img.astro'
interface Props { services: any[]; light?: boolean; headingLevel?: 'h2' | 'h3' }
const {services, light = false, headingLevel = 'h3'} = Astro.props
const H = headingLevel
---
<div class:list={['grid-cards', {light}]}>
  {services.map((sv) => (
    <a class="svc reveal" href={`/services/${sv.slug}`}>
      <div class="ph"><Img image={sv.image} width={400} aspect={16 / 10} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 300px" alt={sv.image?.alt || ''} /></div>
      <div class="body">
        <H>{sv.title}</H>
        <p>{sv.summary}</p>
        {sv.priceText && <p class="price">{sv.priceText}</p>}
      </div>
    </a>
  ))}
</div>

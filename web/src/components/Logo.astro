---
import {pic} from '../lib/image'
interface Props { image: any; name: string; height: number; dark?: boolean }
const {image, name, height, dark = false} = Astro.props
const p = pic(image, {width: Math.round(height * 3)})
const fg = dark ? '#FFFFFF' : '#141E5B'
---
{p ? (
  <img src={p.src} srcset={p.srcset} sizes={`${Math.round(height * 3)}px`} width={p.width} height={p.height} alt={name} style={`height:${height}px;width:auto`} decoding="async" />
) : (
  <svg height={height} viewBox="0 0 220 64" role="img" aria-label={name} style={`height:${height}px;width:auto`}>
    <circle cx="32" cy="32" r="15" fill="#FF6801" />
    <g stroke="#FF6801" stroke-width="3" stroke-linecap="round">
      <line x1="32" y1="5" x2="32" y2="11" /><line x1="32" y1="53" x2="32" y2="59" />
      <line x1="5" y1="32" x2="11" y2="32" /><line x1="53" y1="32" x2="59" y2="32" />
      <line x1="13" y1="13" x2="17" y2="17" /><line x1="47" y1="47" x2="51" y2="51" />
      <line x1="51" y1="13" x2="47" y2="17" /><line x1="13" y1="51" x2="17" y2="47" />
    </g>
    <text x="70" y="42" font-family="Archivo Variable, Archivo, sans-serif" font-weight="900" font-size="30" fill={fg}>{name}</text>
  </svg>
)}

---
import Logo from './Logo.astro'
import Icon from './Icon.astro'
import type {SiteData} from '../data/fallback'
interface Props { data: SiteData }
const {data: d} = Astro.props
const path = Astro.url.pathname.replace(/\.html$/, '')
const links = [
  {href: '/pm-surya-ghar-subsidy-odisha', label: 'Subsidy'},
  {href: '/services', label: 'Services'},
  {href: '/projects', label: 'Projects'},
  ...(d.posts.length ? [{href: '/blog', label: 'Solar guide'}] : []),
  {href: '/faq', label: 'FAQ'},
  {href: '/contact', label: 'Contact'},
]
const current = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined)
---
<header class="site-header">
  <div class="wrap">
    <a href="/" class="brand" aria-label={`${d.settings.businessName} – home`}>
      <Logo image={d.settings.logo} name={d.settings.businessName} height={64} />
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
    </nav>
    <div class="header-cta">
      <a class="btn btn-navy" href="/contact#enquiry">Get a free quote</a>
      <details class="menu">
        <summary aria-label="Open menu"><Icon name="menu" size={24} /></summary>
        <nav class="menu-panel" aria-label="Mobile">
          <a href="/">Home</a>
          {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
          <a class="btn btn-orange" href="/contact#enquiry" style="margin-top:8px">Get a free quote</a>
        </nav>
      </details>
    </div>
  </div>
</header>

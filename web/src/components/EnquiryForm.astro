---
/**
 * Lead form. Posts to /api/lead (Cloudflare Worker in worker/index.ts), which saves the lead in the admin (Sanity)
 * and emails you. Works without JavaScript too (normal form post → thank-you page).
 */
import {telLink} from '../lib/data'
import type {SiteData} from '../data/fallback'
interface Props { data: SiteData; source?: string }
const {data: d, source} = Astro.props
const s = d.settings
const from = source || Astro.url.pathname
---
<div data-lead>
  <form class="form" action="/api/lead" method="post" novalidate>
    <input type="hidden" name="page" value={from} />
    <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>
    <div class="form-row">
      <label class="field">Full name<input type="text" name="name" required autocomplete="name" maxlength="80" placeholder="e.g. Ramesh Das" /></label>
      <label class="field">Mobile number<input type="tel" name="phone" required autocomplete="tel" inputmode="numeric" pattern="[0-9+\s-]{10,15}" maxlength="15" placeholder="10-digit mobile" /></label>
    </div>
    <label class="field">Village / town<input type="text" name="place" required maxlength="80" placeholder="e.g. Nilagiri, Soro, Bhadrak" /></label>
    <div class="form-row">
      <label class="field">Solar for
        <select name="solarFor">
          <option>Home (with subsidy)</option>
          <option>Home with battery backup</option>
          <option>Shop / office</option>
          <option>School / hospital / industry</option>
          <option>Repair or service</option>
        </select>
      </label>
      <label class="field">Monthly electricity bill
        <select name="bill">
          <option>Below ₹1,000</option>
          <option>₹1,000 – ₹2,000</option>
          <option>₹2,000 – ₹4,000</option>
          <option>Above ₹4,000</option>
        </select>
      </label>
    </div>
    <label class="field">Anything else? (optional)<textarea name="message" rows="3" maxlength="1000" placeholder="Roof size, best time to call…"></textarea></label>
    <p class="form-msg" role="alert" hidden></p>
    <button class="btn btn-orange btn-lg btn-block" type="submit">Request my free survey</button>
    <p style="font-size:13px;color:var(--muted)">We only use your number to call you about solar. No spam. <a href="/privacy-policy">Privacy policy</a></p>
  </form>
  <div class="form-done" role="status" hidden tabindex="-1">
    <h3>Thank you! We've got your request.</h3>
    <p>Our team will call you within working hours ({s.hoursText}). Need us sooner? Call <a href={telLink(s)} style="color:#FFB37A">{s.phoneDisplay}</a>.</p>
  </div>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-lead]')) {
    const form = box.querySelector('form')!
    const msg = form.querySelector<HTMLElement>('.form-msg')!
    const done = box.querySelector<HTMLElement>('.form-done')!
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!
    const show = (t: string) => { msg.textContent = t; msg.className = 'form-msg err'; msg.hidden = false }
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const fd = new FormData(form)
      const phone = String(fd.get('phone') || '').replace(/\D/g, '').replace(/^91(?=\d{10}$)/, '')
      if (!String(fd.get('name') || '').trim()) return show('Please enter your name.')
      if (!/^[6-9]\d{9}$/.test(phone)) return show('Please enter a valid 10-digit mobile number.')
      if (!String(fd.get('place') || '').trim()) return show('Please enter your village or town.')
      msg.hidden = true
      btn.disabled = true
      btn.textContent = 'Sending…'
      try {
        const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } })
        const json = await res.json().catch(() => ({}))
        if (!res.ok || !json.ok) throw new Error(json.error || 'Something went wrong')
        form.hidden = true
        done.hidden = false
        done.focus()
        ;(window as any).gtag?.('event', 'generate_lead')
      } catch (err) {
        show('Sorry, we could not send your request. Please call or WhatsApp us instead.')
        btn.disabled = false
        btn.textContent = 'Request my free survey'
      }
    })
  }
</script>

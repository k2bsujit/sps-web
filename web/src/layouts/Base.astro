---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Icon from '../components/Icon.astro'
import {getData, waLink, telLink} from '../lib/data'
import {ogUrl} from '../lib/image'
import {localBusiness} from '../lib/schema'

interface Props {
  title?: string
  description?: string
  seo?: any
  image?: any
  schema?: any[]
  noindex?: boolean
  showCta?: boolean
}
const {title, description, seo, image, schema = [], noindex = false, showCta = true} = Astro.props
const d = await getData()
const s = d.settings
const site = Astro.site!

const pageTitle = seo?.title || title || s.seo.title
const fullTitle = pageTitle.includes(s.businessName) ? pageTitle : `${pageTitle} | ${s.businessName}`
const desc = seo?.description || description || s.seo.description
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site).href
const og = ogUrl(seo?.ogImage) || ogUrl(image) || ogUrl(s.seo?.ogImage) || new URL('/images/og-default.png', site).href
const robots = noindex || seo?.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'
const ld = [localBusiness(d, site), ...schema]
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0C1240" />
    <meta name="geo.region" content="IN-OR" />
    {s.locality && <meta name="geo.placename" content={`${s.locality}, ${s.district}`} />}
    {s.googleVerification && <meta name="google-site-verification" content={s.googleVerification} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={s.businessName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header data={d} />
    <main id="main">
      <slot />
    </main>
    <Footer data={d} showCta={showCta} />
    <div class="float">
      <a class="wa" href={waLink(s)} aria-label="Chat on WhatsApp" rel="noopener">
        <Icon name="chat" size={26} />
      </a>
      <a class="call" href={telLink(s)} aria-label={`Call ${s.businessName}`}>
        <Icon name="phone" size={24} />
      </a>
    </div>
  </body>
</html>

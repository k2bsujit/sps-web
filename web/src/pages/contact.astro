---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import EnquiryForm from '../components/EnquiryForm.astro'
import ContactCard from '../components/ContactCard.astro'
import {getData} from '../lib/data'
import {breadcrumbs} from '../lib/schema'

const d = await getData()
const s = d.settings
const crumbs = [{name: 'Home', url: '/'}, {name: 'Contact', url: '/contact'}]
const mapQ = s.lat && s.lng ? `${s.lat},${s.lng}` : encodeURIComponent(`${s.businessName}, ${s.streetAddress}, ${s.locality}, ${s.district}`)
---
<Base
  title={`Contact ${s.businessName} – Book a Free Solar Survey`}
  description={`Call ${s.phoneDisplay}, WhatsApp us or visit our office in ${s.locality}, ${s.district}. Free home survey for rooftop solar with subsidy.`}
  schema={[breadcrumbs(crumbs, Astro.site!)]}
  showCta={false}
>
  <PageHero title="Book your free home survey" intro={d.home.enquiryTitle} crumbs={crumbs} />
  <section id="enquiry" class="wrap section enquiry">
    <div><EnquiryForm data={d} /></div>
    <div><ContactCard data={d} /></div>
  </section>
  <section class="wrap" style="padding-bottom:80px">
    <iframe
      title={`Map to ${s.businessName}`}
      src={`https://maps.google.com/maps?q=${mapQ}&z=15&output=embed`}
      width="1200" height="380" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
      style="width:100%;height:380px;border:0;border-radius:24px"></iframe>
  </section>
</Base>

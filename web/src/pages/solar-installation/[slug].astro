---
/** One page per area — only for areas where "Publish a page" is switched on in the admin. */
import Base from '../../layouts/Base.astro'
import PageHero from '../../components/PageHero.astro'
import PortableText from '../../components/PortableText.astro'
import ServiceCards from '../../components/ServiceCards.astro'
import ProjectTiles from '../../components/ProjectTiles.astro'
import Calculator from '../../components/Calculator.astro'
import EnquiryForm from '../../components/EnquiryForm.astro'
import {getData, liveAreas} from '../../lib/data'
import {breadcrumbs} from '../../lib/schema'

export async function getStaticPaths() {
  const d = await getData()
  return liveAreas(d).map((a: any) => ({params: {slug: a.slug}, props: {slug: a.slug}}))
}
const d = await getData()
const a: any = d.areas.find((x: any) => x.slug === Astro.props.slug)
const s = d.settings
const projects = d.projects.filter((p: any) => p.area?.slug === a.slug).slice(0, 6)
const nearby = liveAreas(d).filter((x: any) => x.slug !== a.slug)
const crumbs = [{name: 'Home', url: '/'}, {name: `Solar in ${a.name}`, url: `/solar-installation/${a.slug}`}]
const title = `Rooftop solar installation in ${a.name}${a.district && a.district !== a.name ? `, ${a.district}` : ''}`
const desc =
  a.seo?.description ||
  `Rooftop solar in ${a.name} with PM Surya Ghar + Odisha subsidy. Free home survey, paperwork, installation and net meter by ${s.businessName}, ${s.locality}.`
---
<Base title={a.seo?.title || `Rooftop Solar in ${a.name} | Subsidy up to ₹1,38,000`} description={desc} seo={a.seo} schema={[breadcrumbs(crumbs, Astro.site!)]}>
  <PageHero title={title} intro={a.intro} crumbs={crumbs}>
    <div class="btn-row" style="margin-top:8px"><a class="btn btn-orange btn-lg" href="#enquiry">Book a free survey in {a.name}</a></div>
  </PageHero>

  <section class="wrap section two-col">
    <article class="stack" style="gap:36px">
      <PortableText value={a.body} />
      {projects.length > 0 && (
        <div class="stack" style="gap:16px">
          <h2 class="h2" style="font-size:32px">Our installations in {a.name}</h2>
          <div class="gallery"><ProjectTiles projects={projects} /></div>
        </div>
      )}
      <div class="stack" style="gap:16px">
        <h2 class="h2" style="font-size:32px">What we install in {a.name}</h2>
        <ServiceCards services={d.services} light />
      </div>
      {nearby.length > 0 && (
        <div class="stack" style="gap:12px">
          <h2 style="font-size:22px">Nearby areas we serve</h2>
          <ul class="chips">{nearby.map((n: any) => <li><a href={`/solar-installation/${n.slug}`}>{n.name}</a></li>)}</ul>
        </div>
      )}
    </article>
    <aside class="sticky-side"><Calculator data={d} id="area" /></aside>
  </section>

  <section id="enquiry" class="bg-cream">
    <div class="wrap section" style="max-width:820px">
      <div class="stack" style="gap:16px;margin-bottom:24px"><p class="eyebrow">Free home survey</p><h2 class="h2">Get solar on your roof in {a.name}.</h2></div>
      <EnquiryForm data={d} />
    </div>
  </section>
</Base>
